# Local demo uses no credentials and never makes a Qloo request.
APP_MODE=fixture
PORT=4312
HOST=127.0.0.1

# npm ci installs the exact pinned harness version.
# Obtain your individually issued hackathon credential, then switch APP_MODE=live.
QLOO_API_KEY=
QLOO_SERVER_URL=https://hackathon.api.qloo.com
QLOO_BIN=qloo
# Use the pinned Node entrypoint directly, including on Windows.
QLOO_NODE_ENTRY=node_modules/@qloo/qloo-harness/dist/bin.js
QLOO_TIMEOUT_MS=25000
QLOO_MAX_WORKFLOWS=22
QLOO_MAX_WORKFLOWS_PER_HOUR=88
QLOO_BUDGET_FILE=.data/qloo-workflow-budget.json

# Optional live smoke: replace with one real, verified Qloo entity UUID.
QLOO_SMOKE_ENTITY_ID=

# Submission requires a public live app without private access. Set HOST=0.0.0.0,
# PUBLIC_DEMO=true, keep APP_ACCESS_CODE empty, and use one replica with a
# persistent .data volume. The global workflow budget survives restarts.
PUBLIC_DEMO=false

# Private development only. A code-gated deployment does not satisfy the current
# contest's public-app requirement. Never set this in the submission deployment.
APP_ACCESS_CODE=
